<%#
  Hero diagram: four things the plant makes, drawn as a technical plate.

  The colour split carries the meaning. Grey is the customer's asset — the
  drum, the bag, the machine, the palletised load. Orange is the part we make
  and the part that does the protecting. Read together, the drawing says what
  the headline says, which is why it earns the space beside it.

  The drum is drawn exploded, liner lifted clear above it, because a liner
  drawn concentric inside a drum just reads as a second rim.

  No text inside the SVG. Type at drawing scale would fall to nine pixels on a
  phone, so the names sit in the HTML legend underneath, where they are real
  text, always legible, and links into the range.
%>
<svg class="diagram" viewBox="0 0 600 500" role="img"
     aria-label="Technical drawing of four products. A round drum liner lifted clear above the drum it fits. An FIBC bulk bag with an inner liner shown dashed. A machine under a fabricated cover. A palletised load under a pallet cover."
     xmlns="http://www.w3.org/2000/svg">

  <!-- drawing-sheet crop marks -->
  <g class="dl-crop">
    <path d="M10 30V10h20M590 30V10h-20M590 470v20h-20M10 470v20h20"/>
  </g>

  <!-- ================================== round drum liner, exploded view -->
  <g>
    <!-- the liner, lifted clear of the drum -->
    <ellipse class="dl-a" cx="170" cy="68" rx="50" ry="16"/>
    <path class="dl-a" d="M120 68v56M220 68v56"/>
    <path class="dl-a" d="M120 124a50 16 0 0 0 100 0"/>

    <!-- assembly direction -->
    <path class="dl-d dl-dash" d="M170 146v16"/>
    <path class="dl-d" d="M164 157l6 8 6-8"/>

    <!-- the drum: open top, two rolling hoops -->
    <path class="dl-o dl-fill" d="M104 196a66 21 0 0 1 132 0v104a66 21 0 0 1-132 0Z"/>
    <path class="dl-o" d="M104 196a66 21 0 0 0 132 0"/>
    <path class="dl-d" d="M104 238a66 21 0 0 0 132 0M104 270a66 21 0 0 0 132 0"/>
  </g>

  <!-- ======================================== FIBC bulk bag with liner -->
  <g>
    <!-- lifting loops, at the corners where they actually sit -->
    <path class="dl-o" d="M376 124V96a13 13 0 0 1 26 0v28M498 124V96a13 13 0 0 1 26 0v28"/>

    <!-- bag body, walls bowing out under load -->
    <path class="dl-o dl-fill" d="M370 124h160c6 48 6 90-2 132H372c-8-42-8-84-2-132Z"/>

    <!-- discharge spout -->
    <path class="dl-o" d="M438 256l8 32h12l8-32"/>

    <!-- the liner inside: the part that decides the barrier -->
    <path class="dl-a dl-dash" d="M384 138h132c5 40 5 74-1 104H385c-6-30-6-64-1-104Z"/>
  </g>

  <!-- ============================================ machine under a cover -->
  <g>
    <!-- machine profile -->
    <path class="dl-o dl-fill" d="M92 470v-50h52v-32h70v46h36v36Z"/>

    <!-- cover, made to the machine drawing rather than to a bag size -->
    <path class="dl-a" d="M78 470V414a8 8 0 0 1 8-8h50a8 8 0 0 0 8-8v-18a8 8 0 0 1 8-8h70a8 8 0 0 1 8 8v48a8 8 0 0 0 8 8h20a8 8 0 0 1 8 8v22"/>
    <path class="dl-a dl-dash" d="M78 458h188"/>

    <path class="dl-d" d="M56 470h234"/>
  </g>

  <!-- ======================================= palletised load and cover -->
  <g>
    <!-- the load -->
    <path class="dl-o dl-fill" d="M404 448v-68h124v68Z"/>

    <!-- pallet -->
    <path class="dl-o" d="M380 448h172M380 456h172M380 470h172"/>
    <path class="dl-o" d="M392 456v14M416 456v14M454 456v14M478 456v14M516 456v14M540 456v14"/>

    <!-- pallet cover -->
    <path class="dl-a" d="M394 448V372a8 8 0 0 1 8-8h128a8 8 0 0 1 8 8v76"/>
    <path class="dl-a dl-dash" d="M394 436h144"/>

    <path class="dl-d" d="M360 470h204"/>
  </g>
</svg>
