<section class="cta">
  <div class="wrap">
    <div class="ctapanel">
      <div class="ctapanel__grid">
        <div>
          <p class="eyebrow eyebrow--onink"><%= typeof ctaEyebrow !== 'undefined' ? ctaEyebrow : 'Send us the problem' %></p>
          <h2 class="h-section">
            <%- h.dot(typeof ctaHeading !== 'undefined' ? ctaHeading : 'Send the drawing, the drum, or the data sheet.') %>
          </h2>
          <p class="ctapanel__body">
            <%= typeof ctaBody !== 'undefined' ? ctaBody : 'Every product we make is built to order, so the conversation starts with your specification rather than with our price list. Sample liners and trial covers are supplied for fitment before bulk production begins.' %>
          </p>
          <div class="btn-row" style="margin-top:2rem;">
            <a class="btn btn--primary" href="/specify">
              <%= s.cta_primary || 'Specify your requirement' %>
              <span class="btn__arrow"><%- icon('arrow', 16) %></span>
            </a>
            <a class="btn btn--onink" href="/contact">Talk to the technical team</a>
          </div>
        </div>

        <div>
          <ul class="ctacards">
            <li class="ctacard">
              <%- icon('phone', 20) %>
              <span>
                <span class="ctacard__label">Call</span>
                <a class="ctacard__value" href="tel:<%= (s.phone||'').replace(/\s/g,'') %>"><%= s.phone %></a>
                <span class="ctacard__note"><%= s.contact_person %>, <%= s.contact_title %></span>
              </span>
            </li>
            <li class="ctacard">
              <%- icon('mail', 20) %>
              <span>
                <span class="ctacard__label">Email</span>
                <a class="ctacard__value" href="mailto:<%= s.email %>"><%= s.email %></a>
              </span>
            </li>
            <li class="ctacard">
              <%- icon('factory', 20) %>
              <span>
                <span class="ctacard__label">Plant</span>
                <span class="ctacard__text"><%= s.plant_address %></span>
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
