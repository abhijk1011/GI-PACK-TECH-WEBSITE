<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <div class="footer__brand">
          <img src="<%= s.logo_path %>" alt="" width="34" height="24">
          <span class="brand__name"><%= s.company_name %></span>
        </div>
        <p class="footer__line"><%= s.positioning_line %></p>
        <div class="footer__creds">
          <% if (s.show_iso === '1' && s.iso_text) { %><span class="footer__cred"><%= s.iso_text %></span><% } %>
          <span class="footer__cred"><%= s.nature_of_business %></span>
          <span class="footer__cred">Est. <%= s.established_year %></span>
        </div>

        <%
          /*
           * The same profiles the structured data lists as sameAs. Linking them
           * from a real page is what makes that claim checkable rather than
           * merely asserted — rel="me" says outright that these are the same
           * operator, which is the machine-readable half of the same statement.
           * An unset profile is dropped rather than linked to nothing.
           */
          const socials = [
            { url: s.linkedin_url,        key: 'linkedin',  name: 'LinkedIn' },
            { url: s.instagram_url,       key: 'instagram', name: 'Instagram' },
            { url: s.facebook_url,        key: 'facebook',  name: 'Facebook' },
            { url: s.youtube_url,         key: 'youtube',   name: 'YouTube' },
            { url: s.indiamart_url,       key: 'indiamart', name: 'IndiaMART' },
            { url: s.google_business_url, key: 'google',    name: 'Google Business Profile' }
          ].filter(function (x) { return x.url; });
        %>
        <% if (socials.length) { %>
          <ul class="footer__social">
            <% socials.forEach(function (x) { %>
              <li>
                <a class="footer__social-link"
                   href="<%= x.url %>"
                   target="_blank"
                   rel="me noopener noreferrer"
                   title="<%= x.name %>"
                   aria-label="<%= s.company_name %> on <%= x.name %>">
                  <%- icon.brand(x.key, 18) %>
                </a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>

      <div>
        <h2 class="footer__h">Products</h2>
        <ul class="footer__list">
          <% nav.categories.forEach(function(c){ %>
            <li><a href="/products/<%= c.slug %>"><%= c.short_name || c.name %></a></li>
          <% }) %>
        </ul>
      </div>

      <div>
        <h2 class="footer__h">Company</h2>
        <ul class="footer__list">
          <li><a href="/about">About</a></li>
          <li><a href="/industries">Industries</a></li>
          <li><a href="/materials">Material reference</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/specify">Specify a requirement</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div>
        <h2 class="footer__h">Contact</h2>
        <ul class="footer__list">
          <li><a href="tel:<%= (s.phone||'').replace(/\s/g,'') %>"><%= s.phone %></a></li>
          <li><a href="mailto:<%= s.email %>"><%= s.email %></a></li>
          <% if (s.whatsapp) { %>
            <li><a href="https://wa.me/<%= s.whatsapp %>" rel="noopener">WhatsApp</a></li>
          <% } %>
        </ul>
        <h2 class="footer__h" style="margin-top:1.75rem;">Plant</h2>
        <p class="footer__text"><%= s.plant_address %></p>
      </div>
    </div>

    <div class="footer__bottom">
      <span>&copy; <%= new Date().getFullYear() %> <%= s.company_name %>. <%= s.company_descriptor %>.</span>
      <span>GST <%= s.gst_number %></span>
    </div>
  </div>
</footer>
<script src="<%= assetUrl('/js/site.js') %>" defer></script>
<%- s.body_scripts || '' %>
