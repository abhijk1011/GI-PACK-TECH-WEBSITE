<%
  const title = seo.title
    ? (seo.title.includes(s.company_name) ? seo.title : seo.title + (s.seo_title_suffix || ''))
    : (s.default_seo_title || s.company_name);
  /*
   * Search engines cut a description around 160 characters, mid-word, which
   * looks careless in a result. Trimming at a word boundary here means no page
   * can ship an over-long one, however long the description in the content is.
   */
  const description = h.truncate(seo.description || s.default_seo_description || '', 158);
  const canonical = h.absUrl(seo.path || currentPath);
  const image = h.absUrl(seo.image || s.og_image || s.logo_path);
  const noindex = seo.noindex || s.robots_allow !== '1';
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<meta name="description" content="<%= description %>">
<link rel="canonical" href="<%= canonical %>">
<% if (noindex) { %><meta name="robots" content="noindex, nofollow"><% } else { %><meta name="robots" content="index, follow, max-image-preview:large"><% } %>

<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= s.company_name %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= image %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= description %>">
<meta name="twitter:image" content="<%= image %>">
<meta name="theme-color" content="#F4520E">

<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/favicon.svg">

<%# Typography is self-hosted, so there is no third-party request on the
    critical path. Both faces are variable, and both are used above the fold,
    so both are worth preloading. %>
<link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="<%= assetUrl('/css/site.css') %>">
<script>document.documentElement.className += ' js';</script>

<%
  /*
   * sameAs is the entity's passport. An answer engine reading this page has no
   * way of knowing whether "GI PackTech" is a real manufacturer or a name
   * somebody typed, until it can line this site up against profiles it already
   * trusts. Every address below is one more corroboration, so an empty string
   * is dropped rather than emitted — a sameAs pointing nowhere is worse than
   * one fewer link.
   */
  const sameAs = [
    s.linkedin_url,
    s.indiamart_url,
    s.instagram_url,
    s.facebook_url,
    s.youtube_url,
    s.google_business_url
  ].filter(Boolean);

  // "51 to 100" is written for people; schema.org wants the two numbers.
  const empRange = String(s.employees || '').match(/\d+/g);
%>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': h.absUrl('/') + '#organization',
  name: s.company_name,
  legalName: s.company_name,
  url: h.absUrl('/'),
  logo: h.absUrl(s.logo_path),
  image: h.absUrl(s.og_image || s.logo_path),
  description: s.default_seo_description,
  slogan: s.positioning_line || s.company_descriptor || undefined,
  foundingDate: s.established_year,
  telephone: s.phone,
  email: s.email,
  taxID: s.gst_number || undefined,
  vatID: s.gst_number || undefined,
  naics: '326112',
  sameAs: sameAs.length ? sameAs : undefined,
  numberOfEmployees: empRange && empRange.length === 2
    ? { '@type': 'QuantitativeValue', minValue: Number(empRange[0]), maxValue: Number(empRange[1]) }
    : undefined,
  // The ISO registration is the single strongest trust signal a manufacturer
  // has, and as free text in the footer it is invisible to a machine.
  hasCredential: s.iso_text
    ? {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'certification',
        name: s.iso_text,
        recognizedBy: { '@type': 'Organization', name: 'ISOQAR / UKAS' }
      }
    : undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Plot No. 608, New GIDC, Gundlav',
    addressLocality: 'Valsad',
    addressRegion: 'Gujarat',
    postalCode: '396035',
    addressCountry: 'IN'
  },
  areaServed: [
    { '@type': 'Country', name: 'India' },
    { '@type': 'Place', name: 'Worldwide' }
  ],
  knowsLanguage: ['en', 'hi', 'gu'],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: s.phone,
    email: s.email,
    contactType: 'sales',
    areaServed: 'IN',
    availableLanguage: ['en', 'hi', 'gu']
  }
}) %>
</script>

<%# Naming the site as its own entity, distinct from the company that runs it,
    is what lets an assistant cite "the GI PackTech website" and attribute it
    correctly rather than guessing at the publisher. %>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': h.absUrl('/') + '#website',
  url: h.absUrl('/'),
  name: s.company_name,
  description: s.default_seo_description,
  inLanguage: 'en',
  publisher: { '@id': h.absUrl('/') + '#organization' }
}) %>
</script>

<%# FAQPage markup is what lets a search result expand into the questions and
    what an AI assistant reads when it answers from this site, so the answers
    go in as plain text with no markup of their own. %>
<% if (typeof faqSchema !== 'undefined' && faqSchema.length) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSchema.map(function (f) {
    return {
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer }
    };
  })
}) %>
</script>
<% } %>

<%# Breadcrumbs for any page that sits below the top level. Search results
    render them in place of the raw URL, and they tell an assistant how the
    catalogue is organised. Product pages emit their own, three levels deep. %>
<% if (typeof crumbs !== 'undefined' && crumbs && crumbs.length) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map(function (c, i) {
    return { '@type': 'ListItem', position: i + 1, name: c.name, item: h.absUrl(c.path) };
  })
}) %>
</script>
<% } %>

<%# An ItemList makes the shape of the catalogue explicit rather than leaving
    it to be inferred from the markup. %>
<% if (typeof itemList !== 'undefined' && itemList && itemList.length) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  numberOfItems: itemList.length,
  itemListElement: itemList.map(function (it, i) {
    return { '@type': 'ListItem', position: i + 1, name: it.name, url: h.absUrl(it.path) };
  })
}) %>
</script>
<% } %>

<% if (seo.type === 'product' && seo.product) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: seo.product.name,
  description: description,
  sku: seo.product.code,
  category: seo.product.category_name,
  image: seo.image ? [h.absUrl(seo.image)] : undefined,
  brand: { '@type': 'Brand', name: s.company_name },
  manufacturer: { '@id': h.absUrl('/') + '#organization' },
  material: seo.product.materials,
  /*
   * There is deliberately no `offers` here. Declaring one obliges us to state
   * a price, and every item on this site is made to a drawing, so no price
   * exists to state. An offer without a price is not a partial answer to
   * Google — it is an invalid Product, which is worse than a Product that
   * simply never claimed to be purchasable off the shelf. Inventing a figure
   * to satisfy the validator would be worse still.
   *
   * The commercial facts a machine actually needs — that this is made to
   * order, sold by this company, quoted rather than listed, shipped
   * worldwide — are below as properties instead, where an answer engine reads
   * them just as readily and no validator is misled.
   */
  additionalProperty: [
    seo.product.sizes ? { '@type': 'PropertyValue', name: 'Sizes', value: seo.product.sizes } : null,
    seo.product.applications ? { '@type': 'PropertyValue', name: 'Applications', value: seo.product.applications } : null,
    seo.product.materials ? { '@type': 'PropertyValue', name: 'Materials', value: seo.product.materials } : null,
    seo.product.code ? { '@type': 'PropertyValue', name: 'Catalogue reference', value: seo.product.code } : null,
    { '@type': 'PropertyValue', name: 'Availability', value: 'Made to order against your specification' },
    { '@type': 'PropertyValue', name: 'Pricing', value: 'Quoted per requirement — no list price' },
    { '@type': 'PropertyValue', name: 'Supplied by', value: s.company_name + ', Valsad, Gujarat, India' },
    { '@type': 'PropertyValue', name: 'Ships to', value: 'India and export worldwide' }
  ].filter(Boolean)
}) %>
</script>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Products', item: h.absUrl('/products') },
    { '@type': 'ListItem', position: 2, name: seo.product.category_name, item: h.absUrl('/products/' + seo.product.category_slug) },
    { '@type': 'ListItem', position: 3, name: seo.product.name, item: canonical }
  ]
}) %>
</script>
<% } %>

<%- s.head_scripts || '' %>
