<%
  const title = seo.title
    ? (seo.title.includes(s.company_name) ? seo.title : seo.title + (s.seo_title_suffix || ''))
    : (s.default_seo_title || s.company_name);
  const description = seo.description || s.default_seo_description || '';
  const canonical = h.absUrl(seo.path || currentPath);
  const image = h.absUrl(seo.image || s.og_image || '/img/logo-mark.svg');
  const noindex = seo.noindex || s.robots_allow !== '1';
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<meta name="description" content="<%= description %>">
<link rel="canonical" href="<%= canonical %>">
<% if (noindex) { %><meta name="robots" content="noindex, nofollow"><% } else { %><meta name="robots" content="index, follow, max-image-preview:large"><% } %>

<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= s.company_name %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= image %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= description %>">
<meta name="twitter:image" content="<%= image %>">
<meta name="theme-color" content="#F4520E">

<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/favicon.svg">

<%# Typography is self-hosted, so there is no third-party request on the
    critical path. Both faces are variable, and both are used above the fold,
    so both are worth preloading. %>
<link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="<%= assetUrl('/css/site.css') %>">
<script>document.documentElement.className += ' js';</script>

<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: s.company_name,
  url: h.absUrl('/'),
  logo: h.absUrl('/img/logo-mark.svg'),
  description: s.default_seo_description,
  foundingDate: s.established_year,
  telephone: s.phone,
  email: s.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Plot No. 608, New GIDC, Gundlav',
    addressLocality: 'Valsad',
    addressRegion: 'Gujarat',
    postalCode: '396035',
    addressCountry: 'IN'
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: s.phone,
    contactType: 'sales',
    areaServed: 'IN',
    availableLanguage: ['en', 'hi', 'gu']
  }
}) %>
</script>

<% if (seo.type === 'product' && seo.product) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: seo.product.name,
  description: description,
  sku: seo.product.code,
  category: seo.product.category_name,
  image: seo.image ? [h.absUrl(seo.image)] : undefined,
  brand: { '@type': 'Brand', name: s.company_name },
  manufacturer: { '@type': 'Organization', name: s.company_name },
  material: seo.product.materials,
  additionalProperty: [
    seo.product.sizes ? { '@type': 'PropertyValue', name: 'Sizes', value: seo.product.sizes } : null,
    seo.product.applications ? { '@type': 'PropertyValue', name: 'Applications', value: seo.product.applications } : null
  ].filter(Boolean)
}) %>
</script>
<script type="application/ld+json">
<%- JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Products', item: h.absUrl('/products') },
    { '@type': 'ListItem', position: 2, name: seo.product.category_name, item: h.absUrl('/products/' + seo.product.category_slug) },
    { '@type': 'ListItem', position: 3, name: seo.product.name, item: canonical }
  ]
}) %>
</script>
<% } %>

<%- s.head_scripts || '' %>
