<%
var breadcrumb = '<a href="/admin-panel/enquiries">Enquiries</a> / #' + enquiry.id;
var topActions = '<a class="b b--primary b--sm" href="mailto:' + enquiry.email +
  '?subject=' + encodeURIComponent('Your enquiry — ' + (enquiry.product || 'GI PackTech')) + '">Reply by email</a>';
var specKeys = Object.keys(spec);
%>
<%- include('_head') %>

<div class="grid" style="grid-template-columns: minmax(0,1fr) 320px; align-items:start;">
  <div>
    <div class="panel">
      <div class="panel__head"><h2>Contact</h2></div>
      <div class="tblwrap">
        <table class="tbl">
          <tbody>
            <tr><th style="width:180px;">Name</th><td><%= enquiry.name || '—' %></td></tr>
            <tr><th>Company</th><td><%= enquiry.company || '—' %></td></tr>
            <tr><th>Email</th><td><a href="mailto:<%= enquiry.email %>" style="color:var(--a-orange);"><%= enquiry.email %></a></td></tr>
            <tr><th>Phone</th><td>
              <% if (enquiry.phone) { %>
                <a href="tel:<%= enquiry.phone.replace(/\s/g,'') %>" style="color:var(--a-orange);"><%= enquiry.phone %></a>
              <% } else { %>—<% } %>
            </td></tr>
            <tr><th>Their role</th><td><%= enquiry.job_role || '—' %></td></tr>
            <tr><th>Product</th><td><%= enquiry.product || 'Not specified' %></td></tr>
            <tr><th>Came from</th><td><%= enquiry.source %></td></tr>
            <tr><th>Received</th><td><%= enquiry.created_at %></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <% if (enquiry.message) { %>
      <div class="panel">
        <div class="panel__head"><h2>Their message</h2></div>
        <div class="panel__body" style="white-space:pre-wrap;line-height:1.6;"><%= enquiry.message %></div>
      </div>
    <% } %>

    <% if (specKeys.length) { %>
      <div class="panel">
        <div class="panel__head">
          <h2>Specification given</h2>
          <span class="panel__note" style="margin-left:auto;"><%= specKeys.length %> answers</span>
        </div>
        <div class="tblwrap">
          <table class="tbl">
            <tbody>
              <% specKeys.forEach(function(key){ %>
                <tr>
                  <th style="width:280px;"><%= questions[key] || key.replace(/_/g, ' ') %></th>
                  <td><%= spec[key] %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

  <div>
    <form method="post" action="/admin-panel/enquiries/<%= enquiry.id %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="panel">
        <div class="panel__head"><h2>Status</h2></div>
        <div class="panel__body">
          <div class="f">
            <label class="f__label" for="status">Where this stands</label>
            <select id="status" name="status">
              <% ['new','contacted','sampled','quoted','won','closed'].forEach(function(st){ %>
                <option value="<%= st %>" <%= enquiry.status === st ? 'selected' : '' %>><%= st %></option>
              <% }) %>
            </select>
          </div>
          <div class="f">
            <label class="f__label" for="notes">Internal notes</label>
            <textarea id="notes" name="notes" placeholder="What was sent, what they said, next step…"><%= enquiry.notes %></textarea>
          </div>
          <button class="b b--primary" type="submit" style="width:100%;justify-content:center;">Save</button>
        </div>
      </div>
    </form>

    <div class="panel">
      <div class="panel__head"><h2>Danger zone</h2></div>
      <div class="panel__body">
        <form method="post" action="/admin-panel/enquiries/<%= enquiry.id %>/delete"
              onsubmit="return confirm('Delete this enquiry permanently?')">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="b b--danger b--sm" type="submit">Delete enquiry</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('_foot') %>
