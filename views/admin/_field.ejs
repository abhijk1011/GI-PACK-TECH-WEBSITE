<%
/* Renders one admin form control from a field definition.
   Expects: f (field def), value, and optionally namePrefix. */
var fname = (typeof namePrefix !== 'undefined' ? namePrefix : '') + f.key;
var fid = 'fld_' + fname;
var val = value == null ? '' : String(value);
%>
<% if (f.type === 'bool') { %>
  <div class="f f--check">
    <input type="checkbox" id="<%= fid %>" name="<%= fname %>" value="1" <%= Number(value) ? 'checked' : '' %>>
    <label class="f__label" for="<%= fid %>"><%= f.label %></label>
  </div>
  <% if (f.hint) { %><div class="f__hint" style="margin-top:-.75rem;margin-bottom:1.1rem;"><%= f.hint %></div><% } %>

<% } else { %>
  <div class="f">
    <label class="f__label" for="<%= fid %>">
      <%= f.label %><% if (f.required) { %> <span style="color:var(--a-orange);">*</span><% } %>
    </label>

    <% if (f.type === 'textarea' || f.type === 'lines') { %>
      <textarea id="<%= fid %>" name="<%= fname %>"
                class="<%= f.type === 'lines' ? '' : 'tall' %>"
                <%= f.key === 'seo_description' ? 'data-counter="160"' : '' %>
                <%= f.required ? 'required' : '' %>><%= val %></textarea>

    <% } else if (f.type === 'select') { %>
      <select id="<%= fid %>" name="<%= fname %>">
        <% (f.options || []).forEach(function(opt){ %>
          <option value="<%= opt %>" <%= val === String(opt) ? 'selected' : '' %>><%= opt %></option>
        <% }) %>
      </select>

    <% } else if (f.type === 'number') { %>
      <input type="number" id="<%= fid %>" name="<%= fname %>" value="<%= val %>">

    <% } else if (f.type === 'image') { %>
      <input type="text" id="<%= fid %>" name="<%= fname %>" value="<%= val %>"
             placeholder="/uploads/your-image.jpg" data-imagefield>
      <% if (val) { %>
        <img src="<%= val %>" alt="" style="margin-top:.5rem;max-width:190px;border:1px solid var(--a-line);">
      <% } %>
      <% if (typeof media !== 'undefined' && media.length) { %>
        <details style="margin-top:.5rem;">
          <summary style="cursor:pointer;font-size:.8rem;color:var(--a-ink-3);">Choose from the media library</summary>
          <div class="picker" style="margin-top:.5rem;">
            <% media.forEach(function(m){ %>
              <label>
                <input type="radio" name="<%= fname %>" value="<%= m.path %>" <%= val === m.path ? 'checked' : '' %>>
                <img src="<%= m.path %>" alt="<%= m.alt %>" loading="lazy">
              </label>
            <% }) %>
          </div>
        </details>
      <% } %>

    <% } else { %>
      <input type="text" id="<%= fid %>" name="<%= fname %>" value="<%= val %>"
             <%= f.key === 'seo_title' ? 'data-counter="60"' : '' %>
             <%= f.required ? 'required' : '' %>>
    <% } %>

    <% if (f.hint || f.type === 'lines') { %>
      <div class="f__hint">
        <%= f.hint || '' %><%= f.type === 'lines' && !f.hint ? 'One item per line.' : '' %>
      </div>
    <% } %>
  </div>
<% } %>
