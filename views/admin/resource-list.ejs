<% var topActions = '<a class="b b--primary b--sm" href="/admin-panel/r/' + resource + '/new">New ' + def.singular.toLowerCase() + '</a>' %>
<%- include('_head') %>

<div class="panel">
  <div class="panel__head">
    <h2><%= rows.length %> <%= def.label.toLowerCase() %></h2>
  </div>
  <div class="tblwrap">
    <table class="tbl">
      <thead>
        <tr>
          <% def.listColumns.forEach(function(col){ %>
            <th><%= col.replace(/_/g, ' ') %></th>
          <% }) %>
          <th class="right" style="width:160px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="<%= def.listColumns.length + 1 %>"><div class="empty">Nothing here yet.</div></td></tr>
        <% } %>
        <% rows.forEach(function(row){ %>
          <tr>
            <% def.listColumns.forEach(function(col, i){ %>
              <td>
                <% if (col === 'published') { %>
                  <span class="tag <%= row[col] ? 'tag--on' : 'tag--off' %>"><%= row[col] ? 'Live' : 'Draft' %></span>
                <% } else if (i === 0) { %>
                  <a href="/admin-panel/r/<%= resource %>/<%= row.id %>" style="font-weight:500;"><%= row[col] %></a>
                <% } else { %>
                  <span style="color:var(--a-ink-3);"><%= row[col] %></span>
                <% } %>
              </td>
            <% }) %>
            <td class="right">
              <div class="brow" style="justify-content:flex-end;">
                <a class="b b--ghost b--sm" href="/admin-panel/r/<%= resource %>/<%= row.id %>">Edit</a>
                <% if (def.publicPath) { %>
                  <a class="b b--ghost b--sm" href="<%= def.publicPath(row) %>" target="_blank" rel="noopener">View</a>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('_foot') %>
