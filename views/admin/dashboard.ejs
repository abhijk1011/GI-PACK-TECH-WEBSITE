<% var topActions = '<a class="b b--ghost b--sm" href="/" target="_blank" rel="noopener">View website</a>' %>
<%- include('_head') %>

<div class="grid grid--stats">
  <div class="stat"><div class="stat__n"><%= counts.published %>/<%= counts.products %></div><div class="stat__l">Products published</div></div>
  <div class="stat"><div class="stat__n"><%= counts.withImages %></div><div class="stat__l">With photographs</div></div>
  <div class="stat"><div class="stat__n"><%= counts.categories %></div><div class="stat__l">Categories</div></div>
  <div class="stat"><div class="stat__n"><%= counts.media %></div><div class="stat__l">Media files</div></div>
  <div class="stat <%= counts.newEnquiries ? 'stat--alert' : '' %>">
    <div class="stat__n"><%= counts.newEnquiries %></div><div class="stat__l">New enquiries</div>
  </div>
</div>

<% if (s.robots_allow !== '1') { %>
  <div class="msg msg--warn" style="margin-top:1.25rem;">
    <strong>Search engines are blocked.</strong>
    The site is set to “no index” so it stays out of Google while you review it.
    Turn this on in <a href="/admin-panel/settings" style="text-decoration:underline;">Settings &amp; SEO</a> when you go live.
  </div>
<% } %>

<div class="grid grid--2" style="margin-top:1.25rem;">
  <div class="panel">
    <div class="panel__head">
      <h2>Photographs still needed</h2>
      <span class="tag <%= missingImages.length ? 'tag--warn' : 'tag--on' %>"><%= missingImages.length %> product<%= missingImages.length === 1 ? '' : 's' %></span>
    </div>
    <% if (!missingImages.length) { %>
      <div class="empty">Every product has at least one photograph.</div>
    <% } else { %>
      <div class="panel__body panel__note" style="padding-bottom:0;">
        Until a photograph is uploaded, these products show a neutral “photograph to follow” panel on the
        website. Each one has a shot brief saved against it &mdash; open the product to read it.
      </div>
      <div class="tblwrap">
        <table class="tbl">
          <tbody>
            <% missingImages.forEach(function(p){ %>
              <tr>
                <td>
                  <a href="/admin-panel/products/<%= p.id %>#images" style="font-weight:500;"><%= p.name %></a>
                  <% if (p.image_brief) { %>
                    <div style="font-size:.76rem;color:var(--a-ink-3);margin-top:.2rem;max-width:52ch;">
                      <%= p.image_brief.slice(0, 110) %><%= p.image_brief.length > 110 ? '…' : '' %>
                    </div>
                  <% } %>
                </td>
                <td class="right">
                  <a class="b b--ghost b--sm" href="/admin-panel/products/<%= p.id %>#images">Add photo</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="panel">
    <div class="panel__head">
      <h2>Recent enquiries</h2>
      <a class="b b--ghost b--sm" href="/admin-panel/enquiries" style="margin-left:auto;">View all</a>
    </div>
    <% if (!recent.length) { %>
      <div class="empty">No enquiries yet. They will land here as soon as the site is live.</div>
    <% } else { %>
      <div class="tblwrap">
        <table class="tbl">
          <tbody>
            <% recent.forEach(function(e){ %>
              <tr>
                <td>
                  <a href="/admin-panel/enquiries/<%= e.id %>" style="font-weight:500;"><%= e.name || 'Unnamed' %></a>
                  <div style="font-size:.76rem;color:var(--a-ink-3);"><%= e.company %><%= e.product ? ' · ' + e.product : '' %></div>
                </td>
                <td class="right">
                  <span class="tag <%= e.status === 'new' ? 'tag--new' : '' %>"><%= e.status %></span>
                  <div style="font-size:.7rem;color:var(--a-ink-3);margin-top:.25rem;"><%= e.created_at.slice(0, 10) %></div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<div class="panel" style="margin-top:1.25rem;">
  <div class="panel__head"><h2>Quick links</h2></div>
  <div class="panel__body">
    <div class="brow">
      <a class="b b--ghost" href="/admin-panel/pages/home">Edit home page text</a>
      <a class="b b--ghost" href="/admin-panel/settings">Contact details &amp; SEO</a>
      <a class="b b--ghost" href="/admin-panel/media">Upload photographs</a>
      <a class="b b--ghost" href="/admin-panel/r/value_rows">Value equation rows</a>
      <a class="b b--ghost" href="/sitemap.xml" target="_blank" rel="noopener">Check sitemap</a>
    </div>
  </div>
</div>

<%- include('_foot') %>
