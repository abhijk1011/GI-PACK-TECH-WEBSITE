<%
var breadcrumb = '<a href="/admin-panel/r/' + resource + '">' + def.label + '</a> / ' + (isNew ? 'New' : 'Edit');
var topActions = (!isNew && def.publicPath) ?
  '<a class="b b--ghost b--sm" href="' + def.publicPath(row) + '" target="_blank" rel="noopener">View on site</a>' : '';
var groups = [];
def.fields.forEach(function(f){
  var g = f.group || 'Content';
  var found = groups.find(function(x){ return x.name === g; });
  if (!found) groups.push({ name: g, fields: [f] });
  else found.fields.push(f);
});
%>
<%- include('_head') %>

<form method="post" action="/admin-panel/r/<%= resource %>/<%= isNew ? 'new' : row.id %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <div class="grid" style="grid-template-columns: minmax(0,1fr) 320px; align-items:start;">
    <div>
      <div class="panel">
        <div class="panel__head">
          <h2><%= isNew ? 'New ' + def.singular.toLowerCase() : (row.name || row.title || row.question || def.singular) %></h2>
        </div>
        <div class="panel__body">
          <% groups.forEach(function(g){ %>
            <div class="fgroup">
              <div class="fgroup__h"><%= g.name %></div>
              <% g.fields.forEach(function(f){ %>
                <%- include('_field', { f: f, value: row[f.key], media: [] }) %>
              <% }) %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <div>
      <div class="panel">
        <div class="panel__head"><h2>Save</h2></div>
        <div class="panel__body">
          <button class="b b--primary" type="submit" style="width:100%;justify-content:center;">
            <%= isNew ? 'Create' : 'Save changes' %>
          </button>
        </div>
      </div>

      <% if (def.links) { %>
        <div class="panel">
          <div class="panel__head"><h2><%= def.links.label %></h2></div>
          <div class="panel__body">
            <div class="checklist">
              <% allProducts.forEach(function(p){ %>
                <label>
                  <input type="checkbox" name="linked" value="<%= p.id %>" <%= linked.indexOf(p.id) !== -1 ? 'checked' : '' %>>
                  <span><%= p.name %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</form>

<% if (!isNew) { %>
  <div class="panel" style="margin-top:1.25rem;">
    <div class="panel__head"><h2>Danger zone</h2></div>
    <div class="panel__body">
      <form method="post" action="/admin-panel/r/<%= resource %>/<%= row.id %>/delete"
            onsubmit="return confirm('Delete this permanently? This cannot be undone.')">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="b b--danger" type="submit">Delete this <%= def.singular.toLowerCase() %></button>
      </form>
    </div>
  </div>
<% } %>

<%- include('_foot') %>
