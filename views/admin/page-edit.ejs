<%
var breadcrumb = '<a href="/admin-panel/pages">Pages</a> / ' + page.title;
var href = page.slug === 'home' ? '/' : '/' + page.slug;
var topActions = '<a class="b b--ghost b--sm" href="' + href + '" target="_blank" rel="noopener">View on site</a>';
%>
<%- include('_head') %>

<form method="post" action="/admin-panel/pages/<%= page.slug %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <div class="grid" style="grid-template-columns: minmax(0,1fr) 320px; align-items:start;">
    <div>
      <div class="panel">
        <div class="panel__head">
          <h2>Page sections</h2>
          <span class="panel__note" style="margin-left:auto;">In the order they appear on the page</span>
        </div>
        <div class="panel__body">
          <% blocks.forEach(function(b){ %>
            <div class="f">
              <label class="f__label" for="blk_<%= b.block_key %>"><%= b.label %></label>

              <% if (b.input_type === 'image') { %>
                <input type="text" id="blk_<%= b.block_key %>" name="block_<%= b.block_key %>" value="<%= b.value %>" placeholder="/uploads/your-image.jpg">
                <% if (b.value) { %>
                  <img src="<%= b.value %>" alt="" style="margin-top:.5rem;max-width:220px;border:1px solid var(--a-line);">
                <% } %>
                <% if (media.length) { %>
                  <details style="margin-top:.5rem;">
                    <summary style="cursor:pointer;font-size:.8rem;color:var(--a-ink-3);">Choose from the media library</summary>
                    <div class="picker" style="margin-top:.5rem;">
                      <% media.forEach(function(m){ %>
                        <label>
                          <input type="radio" name="block_<%= b.block_key %>" value="<%= m.path %>" <%= b.value === m.path ? 'checked' : '' %>>
                          <img src="<%= m.path %>" alt="<%= m.alt %>" loading="lazy">
                        </label>
                      <% }) %>
                    </div>
                  </details>
                <% } %>

              <% } else if (b.input_type === 'textarea') { %>
                <textarea id="blk_<%= b.block_key %>" name="block_<%= b.block_key %>"><%= b.value %></textarea>

              <% } else { %>
                <input type="text" id="blk_<%= b.block_key %>" name="block_<%= b.block_key %>" value="<%= b.value %>">
              <% } %>

              <% if (b.hint) { %><div class="f__hint"><%= b.hint %></div><% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <div>
      <div class="panel">
        <div class="panel__head"><h2>Save</h2></div>
        <div class="panel__body">
          <button class="b b--primary" type="submit" style="width:100%;justify-content:center;">Save changes</button>
        </div>
      </div>

      <div class="panel">
        <div class="panel__head"><h2>Search engine listing</h2></div>
        <div class="panel__body">
          <div class="f">
            <label class="f__label" for="title">Page name <span class="panel__note">(admin only)</span></label>
            <input type="text" id="title" name="title" value="<%= page.title %>">
          </div>
          <div class="f">
            <label class="f__label" for="seo_title">SEO title</label>
            <input type="text" id="seo_title" name="seo_title" value="<%= page.seo_title %>" data-counter="60">
            <div class="f__hint">What Google shows as the blue headline.</div>
          </div>
          <div class="f">
            <label class="f__label" for="seo_description">Meta description</label>
            <textarea id="seo_description" name="seo_description" data-counter="160"><%= page.seo_description %></textarea>
            <div class="f__hint">The grey text under the headline. Aim for 150–160 characters.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</form>

<%- include('_foot') %>
