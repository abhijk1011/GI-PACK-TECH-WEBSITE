<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <section class="phero gridbg">
    <div class="wrap">
      <div class="phero__inner">
        <p class="eyebrow"><%= total %> products &nbsp;·&nbsp; <%= s.stat_categories %> categories</p>
        <h1 class="h-page">All products</h1>
        <p class="lede">
          Not the limit of what the plant can make. If a size is not listed, it can almost
          certainly still be built.
        </p>
      </div>
    </div>
  </section>

  <div class="anchor-nav">
    <div class="wrap">
      <ul>
        <% grouped.forEach(function(g){ %>
          <li><a href="#<%= g.slug %>"><%= g.short_name || g.name %></a></li>
        <% }) %>
      </ul>
    </div>
  </div>

  <% grouped.forEach(function(g, gi){ %>
    <section class="section section--tight <%= gi % 2 === 1 ? 'section--paper section--rule' : '' %>" id="<%= g.slug %>">
      <div class="wrap">
        <%- include('../partials/shead', { sh: {
          eyebrow: 'Category ' + g.number, title: g.name, lede: g.tagline,
          link: { href: '/products/' + g.slug, label: 'View category' },
          align: 'left'
        } }) %>

        <%# On a phone each category is a shelf that swipes sideways, so the
            whole range is eight rows deep rather than forty-three cards. %>
        <div class="cards cards--4 cards--loose swipe-sm">
          <% g.products.forEach(function(p){ %>
            <%- include('../partials/product-card', { p: p }) %>
          <% }) %>
        </div>
      </div>
    </section>
  <% }) %>

  <%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
