<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <section class="section section--tight gridbg">
    <div class="wrap">
      <p class="eyebrow">The full range</p>
      <h1 class="h-hero" style="font-size:var(--step-4);max-width:22ch;">
        <%= total %> products across <%= s.stat_categories %> categories.
      </h1>
      <p class="lede" style="margin-top:1.5rem;">
        This is what has been built so far. It is not the limit of what the plant can produce &mdash;
        if a requirement is not listed here, it can almost certainly still be made.
      </p>
    </div>
  </section>

  <div class="anchor-nav">
    <div class="wrap">
      <ul>
        <% grouped.forEach(function(g){ %>
          <li><a href="#<%= g.slug %>"><%= g.short_name || g.name %></a></li>
        <% }) %>
      </ul>
    </div>
  </div>

  <% grouped.forEach(function(g, gi){ %>
    <section class="section section--tight <%= gi % 2 === 1 ? 'section--paper section--rule' : '' %>" id="<%= g.slug %>">
      <div class="wrap">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;margin-bottom:2rem;">
          <div style="max-width:56ch;">
            <p class="eyebrow"><%= g.number %> / <%= s.stat_categories %></p>
            <h2 class="h-section" style="font-size:var(--step-2);"><%= g.name %></h2>
            <p style="color:var(--ink-3);margin-top:.75rem;"><%= g.tagline %></p>
          </div>
          <a class="tlink" href="/products/<%= g.slug %>">Category overview <%- icon('arrow', 15) %></a>
        </div>

        <div class="cards cards--4">
          <% g.products.forEach(function(p){ %>
            <%- include('../partials/product-card', { p: p }) %>
          <% }) %>
        </div>
      </div>
    </section>
  <% }) %>

  <%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
