<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <section class="phero gridbg">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span>
        <span aria-current="page">For <%= role.name %></span>
      </nav>
      <p class="eyebrow">For the <%= role.name.toLowerCase() %></p>
      <h1 class="h-page phero__title" style="max-width:26ch;"><%- h.dot(role.headline) %></h1>
      <p class="lede"><%= role.intro %></p>

      <div class="measured">
        <%- icon(role.icon || 'users', 18) %>
        <span class="mono">Measured on: <%= role.cares_about %></span>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="split split--top">
        <div>
          <p class="eyebrow">What changes</p>
          <ul class="featlist">
            <% h.lines(role.points).forEach(function(pt){ %>
              <li><span class="featlist__text" style="font-size:1.02rem;"><%= pt %></span></li>
            <% }) %>
          </ul>
        </div>
        <div>
          <div class="rail rail--static">
            <h2 class="rail__title">Start from the problem</h2>
            <p class="rail__body">
              Send the product, the container dimensions and the handling conditions. We come back with a
              specification and a sample for trial fitment.
            </p>
            <a class="btn btn--primary" href="/specify?role=<%= encodeURIComponent(role.name) %>">
              <%= s.cta_primary %> <span class="btn__arrow"><%- icon('arrow', 16) %></span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper section--rule">
    <div class="wrap">
      <div class="shead">
        <div class="shead__text">
          <p class="eyebrow">Relevant products</p>
          <h2 class="h-section" style="font-size:var(--step-2);"><%- h.dot('Where this shows up in the range.') %></h2>
        </div>
      </div>
      <div class="cards cards--3 cards--loose">
        <% products.forEach(function(p){ %>
          <%- include('../partials/product-card', { p: p }) %>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <p class="eyebrow">A decision passes through four people</p>
      <div class="roles" style="margin-top:1.5rem;">
        <% roles.forEach(function(r){ %>
          <a class="role" href="/for/<%= r.slug %>" <%= r.slug === role.slug ? 'aria-current="page"' : '' %>>
            <span class="role__icon"><%- icon(r.icon || 'users', 28) %></span>
            <h3 class="role__name" style="font-size:1.05rem;"><%= r.name %></h3>
            <p class="role__cares"><%= r.cares_about %></p>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
