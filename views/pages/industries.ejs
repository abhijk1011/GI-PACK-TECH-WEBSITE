<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <section class="phero gridbg">
    <div class="wrap phero__grid">
      <div class="phero__main">
        <p class="eyebrow"><%= industries.length %> sectors</p>
        <h1 class="h-page">Industries we serve</h1>
      </div>
      <div class="phero__side">
        <p class="lede">
          Different sectors, the same question: what is this packaging protecting? The
          specification starts from your product, your container and your route &mdash; never from
          a standard range.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="cards cards--2">
        <% industries.forEach(function(i){ %>
          <a class="card" href="/industries/<%= i.slug %>">
            <h2 class="card__title"><%= i.name %></h2>
            <% if (i.problem_lead) { %>
              <p class="card__lead"><%= i.problem_lead %></p>
            <% } %>
            <p class="card__desc"><%= i.applications %></p>
            <span class="card__meta">
              <span></span>
              <span class="card__arrow"><%- icon('arrow', 16) %></span>
            </span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
