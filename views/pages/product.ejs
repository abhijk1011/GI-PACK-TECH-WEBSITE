<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <div class="wrap pdp__head">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/products">Products</a><span>/</span>
      <a href="/products/<%= product.category_slug %>"><%= product.category_name %></a><span>/</span>
      <span style="color:var(--ink-3);"><%= product.name %></span>
    </nav>

    <div class="pdp__layout">
      <!-- ------------------------------------------------ left column -->
      <div>
        <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem;">
          <span class="num"><%= product.code %></span>
          <% if (product.badge) { %><span class="badge badge--inline"><%= product.badge %></span><% } %>
        </div>
        <h1 class="h-section" style="font-size:var(--step-4);margin-bottom:1rem;"><%= product.name %></h1>
        <% if (product.tagline) { %>
          <p class="lede"><%= product.tagline %></p>
        <% } %>

        <!-- The page opens with the loss, not the product. -->
        <% if (product.problem_headline) { %>
          <div class="problem">
            <div class="problem__label">The problem it prevents</div>
            <h2 class="problem__head"><%= product.problem_headline %></h2>
            <div class="problem__body">
              <% h.paragraphs(product.problem_body).forEach(function(para){ %>
                <p><%= para %></p>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Gallery -->
        <div style="margin-block:2rem;" data-gallery>
          <figure class="gallery__main ticked" style="margin:0;">
            <% if (images.length) { %>
              <img src="<%= images[0].path %>" alt="<%= images[0].alt || product.name %>"
                   width="900" height="675" data-gallery-main>
            <% } else { %>
              <div class="slot">
                <div>
                  <%- icon('image', 30) %>
                  <span class="slot__label">Photograph to follow</span>
                </div>
              </div>
            <% } %>
          </figure>

          <% if (images.length > 1) { %>
            <div class="gallery__thumbs" role="tablist">
              <% images.forEach(function(img, i){ %>
                <button class="gallery__thumb" type="button" role="tab"
                        aria-selected="<%= i === 0 ? 'true' : 'false' %>"
                        data-src="<%= img.path %>"
                        data-alt="<%= img.alt || product.name %>"
                        data-caption="<%= img.caption || '' %>">
                  <img src="<%= img.path %>" alt="" loading="lazy" width="150" height="150">
                </button>
              <% }) %>
            </div>
          <% } %>

          <% if (images.length && images[0].caption) { %>
            <p class="gallery__caption" data-gallery-caption><%= images[0].caption %></p>
          <% } %>

          <% if (!images.length && product.image_brief) { %>
            <p class="gallery__caption">
              <span class="mono" style="color:var(--ink-4);">PHOTOGRAPH BRIEF ON FILE</span>
            </p>
          <% } %>
        </div>

        <!-- What it is -->
        <section style="margin-block:2.5rem;">
          <h2 class="h-card" style="margin-bottom:1rem;">What it is</h2>
          <div class="prose">
            <% h.paragraphs(product.description).forEach(function(para){ %>
              <p><%= para %></p>
            <% }) %>
          </div>
        </section>

        <!-- Key features -->
        <% var features = h.lines(product.features); if (features.length) { %>
          <section style="margin-block:2.5rem;">
            <h2 class="h-card" style="margin-bottom:1.25rem;">Key features</h2>
            <ul class="ticklist">
              <% features.forEach(function(f){ %>
                <li><%- icon('check', 16) %><span><%= f %></span></li>
              <% }) %>
            </ul>
          </section>
        <% } %>

        <!-- Specification -->
        <section style="margin-block:2.5rem;">
          <h2 class="h-card" style="margin-bottom:1.25rem;">Specification</h2>
          <div class="spec">
            <% if (product.materials) { %>
              <div class="spec__row"><div class="spec__key">Materials</div><div class="spec__val"><%= product.materials %></div></div>
            <% } %>
            <% if (product.sizes) { %>
              <div class="spec__row"><div class="spec__key">Sizes</div><div class="spec__val"><%= product.sizes %></div></div>
            <% } %>
            <% if (product.applications) { %>
              <div class="spec__row"><div class="spec__key">Applications</div><div class="spec__val"><%= product.applications %></div></div>
            <% } %>
            <% if (product.where_used) { %>
              <div class="spec__row"><div class="spec__key">Where it is used</div><div class="spec__val"><%= product.where_used %></div></div>
            <% } %>
            <div class="spec__row">
              <div class="spec__key">Category</div>
              <div class="spec__val"><a class="tlink" href="/products/<%= product.category_slug %>"><%= product.category_name %></a></div>
            </div>
          </div>
        </section>

        <!-- How we build it -->
        <% if (product.difference_body) { %>
          <section style="margin-block:2.5rem;">
            <h2 class="h-card" style="margin-bottom:1rem;">How we build it</h2>
            <div class="prose">
              <% h.paragraphs(product.difference_body).forEach(function(para){ %>
                <p><%= para %></p>
              <% }) %>
            </div>
          </section>
        <% } %>

        <!-- Customisation: the upsell surface -->
        <% var options = h.lines(product.customise); if (options.length) { %>
          <section style="margin-block:2.5rem;padding:1.75rem;border:1px solid var(--line);background:var(--paper-2);">
            <h2 class="h-card" style="margin-bottom:.75rem;">Built to your specification</h2>
            <p style="color:var(--ink-3);font-size:.92rem;margin-bottom:1.25rem;max-width:60ch;">
              Nothing here is sold from a fixed standard range. Every one of these can be changed for your
              application, and a sample is supplied for trial fitment before bulk production.
            </p>
            <ul class="optionchips">
              <% options.forEach(function(o){ %>
                <li class="optionchip"><%= o %></li>
              <% }) %>
            </ul>
          </section>
        <% } %>

        <!-- Industries -->
        <% if (industries.length) { %>
          <section style="margin-block:2.5rem;">
            <h2 class="h-card" style="margin-bottom:1rem;">Specified in</h2>
            <div class="optionchips">
              <% industries.forEach(function(i){ %>
                <a class="optionchip" href="/industries/<%= i.slug %>"><%= i.name %></a>
              <% }) %>
            </div>
          </section>
        <% } %>
      </div>

      <!-- ------------------------------------------------ sticky rail -->
      <aside>
        <div class="rail ticked">
          <h2 class="rail__title">Specify this product</h2>
          <p class="rail__body">
            Tell us what you are packing and the dimensions you are working to. We come back with a
            specification, not just a price.
          </p>
          <ul class="rail__list">
            <li><%- icon('check', 14) %><span>Sample supplied for trial fitment</span></li>
            <li><%- icon('check', 14) %><span>Material specified against your product data</span></li>
            <li><%- icon('check', 14) %><span>Made to your drawing or measured container</span></li>
          </ul>
          <a class="btn btn--primary" href="/specify?product=<%= encodeURIComponent(product.name) %>">
            <%= s.cta_primary %> <span class="btn__arrow"><%- icon('arrow', 16) %></span>
          </a>
          <div class="rail__contact">
            <div style="display:flex;gap:.6rem;align-items:center;margin-bottom:.6rem;">
              <%- icon('phone', 15) %>
              <a href="tel:<%= (s.phone||'').replace(/\s/g,'') %>"><%= s.phone %></a>
            </div>
            <div style="display:flex;gap:.6rem;align-items:center;">
              <%- icon('mail', 15) %>
              <a href="mailto:<%= s.email %>?subject=<%= encodeURIComponent('Enquiry: ' + product.name) %>"><%= s.email %></a>
            </div>
          </div>
        </div>

        <!-- Same-category navigation keeps buyers inside the range -->
        <% if (siblings.length) { %>
          <div style="margin-top:1.5rem;border:1px solid var(--line);">
            <div style="padding:1rem 1.25rem;border-bottom:1px solid var(--line);background:var(--paper-2);">
              <span class="mono" style="color:var(--ink-3);letter-spacing:.1em;text-transform:uppercase;">
                More in <%= product.category_short || product.category_name %>
              </span>
            </div>
            <ul>
              <% siblings.forEach(function(sib){ %>
                <li>
                  <a href="/products/<%= product.category_slug %>/<%= sib.slug %>"
                     style="display:flex;justify-content:space-between;gap:1rem;align-items:center;padding:.85rem 1.25rem;border-bottom:1px solid var(--line);font-size:.88rem;color:var(--ink-2);">
                    <span><%= sib.name %></span>
                    <span style="color:var(--ink-4);flex:none;"><%- icon('arrow', 14) %></span>
                  </a>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </aside>
    </div>
  </div>

  <!-- ------------------------------------------------ cross-sell -->
  <% if (related.length) { %>
    <section class="section section--paper section--rule">
      <div class="wrap">
        <div style="max-width:52ch;margin-bottom:2rem;">
          <p class="eyebrow">Commonly specified with</p>
          <h2 class="h-section" style="font-size:var(--step-2);">
            These are usually part of the same conversation.
          </h2>
        </div>
        <div class="cards cards--3">
          <% related.forEach(function(p){ %>
            <%- include('../partials/product-card', { p: p }) %>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
