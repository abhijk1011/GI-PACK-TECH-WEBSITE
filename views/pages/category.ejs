<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <% var heroImage = (products.find(function(p){ return p.image; }) || {}).image; %>
  <section class="phero gridbg">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/products">Products</a><span>/</span>
        <span aria-current="page"><%= category.name %></span>
      </nav>
      <div class="mhero">
        <div class="mhero__head">
          <p class="eyebrow">Category <%= category.number %> &nbsp;·&nbsp; <%= products.length %> products</p>
          <h1 class="h-page"><%= category.name %></h1>
          <% if (category.problem_lead) { %>
            <p class="mhero__lead"><%= category.problem_lead %></p>
          <% } %>
        </div>
        <% if (heroImage) { %>
          <figure class="mhero__media">
            <img src="<%= heroImage.path %>" alt="<%= heroImage.alt || category.name %>"
                 width="900" height="675" fetchpriority="high" decoding="async">
          </figure>
        <% } %>
        <div class="mhero__body">
          <div class="prose">
            <% h.paragraphs(category.intro).forEach(function(para){ %><p><%= para %></p><% }) %>
          </div>
          <div class="btn-row">
            <a class="btn btn--primary" href="/specify">
              <%= s.cta_primary %> <span class="btn__arrow"><%- icon('arrow', 16) %></span>
            </a>
            <a class="btn btn--ghost" href="#range">See the <%= products.length %> products</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight section--rule" id="range">
    <div class="wrap">
      <%# An h2 here keeps the outline h1 -> h2 -> h3; the cards below are h3. %>
      <%- include('../partials/shead', { sh: {
        eyebrow: category.short_name || category.name,
        title: 'Products in this range',
        lede: category.tagline,
        link: { href: '/specify', label: 'Specify a requirement' }
      } }) %>
      <div class="cards cards--3 cards--loose">
        <% products.forEach(function(p){ %>
          <%- include('../partials/product-card', { p: p }) %>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section section--paper section--rule">
    <div class="wrap">
      <%- include('../partials/shead', { sh: {
        eyebrow: 'Products', title: 'Other categories',
        link: { href: '/products', label: 'All products' }
      } }) %>
      <nav class="linklist" aria-label="Other categories">
        <% others.forEach(function(c){ %>
          <a href="/products/<%= c.slug %>">
            <span class="card__num"><%= c.number %></span>
            <span><%= c.short_name || c.name %></span>
            <span class="card__arrow"><%- icon('arrow', 15) %></span>
          </a>
        <% }) %>
      </nav>
    </div>
  </section>

  <%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
