<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <section class="phero gridbg">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/products">Products</a><span>/</span>
        <span aria-current="page"><%= category.name %></span>
      </nav>
      <p class="eyebrow"><%= category.number %> / <%= s.stat_categories %> &nbsp;·&nbsp; <%= products.length %> products</p>
      <h1 class="h-page phero__title" style="max-width:20ch;"><%- h.dot(category.name) %></h1>
      <% if (category.problem_lead) { %>
        <p class="subhead" style="margin-top:1.35rem;max-width:52ch;"><%= category.problem_lead %></p>
      <% } %>
      <div class="prose" style="margin-top:1.5rem;">
        <% h.paragraphs(category.intro).forEach(function(para){ %><p><%= para %></p><% }) %>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <%# An h2 here keeps the outline h1 -> h2 -> h3; the cards below are h3. %>
      <div class="shead">
        <div class="shead__text">
          <h2 class="h-section" style="font-size:var(--step-2);">
            <%- h.dot(products.length + ' products in this range') %>
          </h2>
        </div>
        <a class="tlink" href="/specify">Specify a requirement <%- icon('arrow', 15) %></a>
      </div>
      <div class="cards cards--3 cards--loose">
        <% products.forEach(function(p){ %>
          <%- include('../partials/product-card', { p: p }) %>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section section--paper section--rule">
    <div class="wrap">
      <p class="eyebrow">Other categories</p>
      <div class="cards cards--4" style="margin-top:1.5rem;">
        <% others.forEach(function(c){ %>
          <a class="card" href="/products/<%= c.slug %>">
            <span class="card__num"><%= c.number %></span>
            <h3 class="card__title" style="font-size:1.02rem;"><%= c.short_name || c.name %></h3>
            <span class="card__meta"><span></span><span class="card__arrow"><%- icon('arrow', 15) %></span></span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
