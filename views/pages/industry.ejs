<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <% var heroImage = (products.find(function(p){ return p.image; }) || {}).image; %>
  <section class="phero gridbg">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/industries">Industries</a><span>/</span>
        <span aria-current="page"><%= industry.name %></span>
      </nav>
      <div class="mhero">
        <div class="mhero__head">
          <p class="eyebrow">Industry</p>
          <h1 class="h-page"><%= industry.name %></h1>
          <% if (industry.problem_lead) { %>
            <p class="mhero__lead"><%= industry.problem_lead %></p>
          <% } %>
        </div>
        <% if (heroImage) { %>
          <figure class="mhero__media">
            <img src="<%= heroImage.path %>" alt="<%= heroImage.alt || industry.name %>"
                 width="900" height="675" fetchpriority="high" decoding="async">
          </figure>
        <% } %>
        <div class="mhero__body">
          <div class="prose">
            <% h.paragraphs(industry.intro).forEach(function(para){ %><p><%= para %></p><% }) %>
          </div>
          <div class="btn-row">
            <a class="btn btn--primary" href="/specify">
              <%= s.cta_primary %> <span class="btn__arrow"><%- icon('arrow', 16) %></span>
            </a>
            <a class="btn btn--ghost" href="#products">Recommended products</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight section--rule" id="products">
    <div class="wrap">
      <%- include('../partials/shead', { sh: {
        eyebrow: 'Specified here', title: 'Recommended products',
        lede: 'Products built for this sector.',
        link: { href: '/products', label: 'All products' }
      } }) %>
      <div class="cards cards--3 cards--loose">
        <% products.forEach(function(p){ %>
          <%- include('../partials/product-card', { p: p }) %>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section section--paper section--rule">
    <div class="wrap">
      <%- include('../partials/shead', { sh: {
        eyebrow: 'Industries', title: 'Other industries',
        link: { href: '/industries', label: 'All industries' }
      } }) %>
      <nav class="linklist" aria-label="Other industries">
        <% others.forEach(function(i){ %>
          <a href="/industries/<%= i.slug %>">
            <span><%= i.name %></span>
            <span class="card__arrow"><%- icon('arrow', 15) %></span>
          </a>
        <% }) %>
      </nav>
    </div>
  </section>

  <%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
