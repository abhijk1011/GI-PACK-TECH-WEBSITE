<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <section class="phero gridbg">
    <div class="wrap">
      <p class="eyebrow"><%= b.hero_eyebrow %></p>
      <h1 class="h-page phero__title"><%- h.dot(b.hero_heading) %></h1>
      <p class="lede"><%= b.intro %></p>
      <div class="btn-row" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/specify">
          <%= s.cta_primary %> <span class="btn__arrow"><%- icon('arrow', 16) %></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <p class="eyebrow">In-house processes</p>
      <div class="cards cards--3" style="margin-top:1.5rem;">
        <% [
          ['Lamination', 'Multilayer and aluminium foil laminate structures, including 5 and 6 layer constructions with nylon and polyester.'],
          ['Extrusion', 'Co-extruded films engineered to get more strength from less material, and to carry EVOH or conductive layers.'],
          ['Cutting and fabrication', 'Any diameter from 6 to 100 inches, any machine profile, from a one-off cover to a bulk production run.'],
          ['Heat sealing', 'The seal is where barrier films are made or lost. Seal specification is developed and tested before dispatch.'],
          ['Vacuum and VCI', 'Vacuum drawing, heat sealing and VCI formulation matched to the metal and the sealed volume.'],
          ['R&D and quality', 'Material compatibility worked out against your product data sheet before anything is quoted.']
        ].forEach(function(item, i){ %>
          <div class="card">
            <span class="card__num">0<%= i + 1 %></span>
            <h2 class="card__title"><%= item[0] %></h2>
            <p class="card__desc"><%= item[1] %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section section--paper section--rule">
    <div class="wrap">
      <div class="split split--top">
        <div>
          <p class="eyebrow">What we need from you</p>
          <h2 class="h-section" style="font-size:var(--step-2);margin-bottom:1.5rem;">
            <%- h.dot('One drawing usually replaces three phone calls.') %>
          </h2>
          <ul class="featlist">
            <li><span class="featlist__text">A machine general arrangement drawing</span></li>
            <li><span class="featlist__text">The drum&rsquo;s measured internal diameter and height, or one sample drum</span></li>
            <li><span class="featlist__text">The product data sheet, so material compatibility can be confirmed</span></li>
            <li><span class="featlist__text">A method statement, where the work is on a licensed site</span></li>
            <li><span class="featlist__text">A container load plan, where the question is freight efficiency</span></li>
          </ul>
          <div class="btn-row" style="margin-top:2rem;">
            <a class="btn btn--ink" href="/specify">Send it through <span class="btn__arrow"><%- icon('arrow', 16) %></span></a>
          </div>
        </div>
        <div>
          <p class="eyebrow">Product families</p>
          <div class="cards" style="grid-template-columns:1fr;">
            <% categories.forEach(function(c){ %>
              <a class="card" href="/products/<%= c.slug %>" style="padding:1.15rem 1.5rem;">
                <span class="card__num"><%= c.number %></span>
                <h3 class="card__title" style="font-size:1.02rem;"><%= c.name %></h3>
                <span class="card__meta" style="padding-top:.5rem;"><span></span><span class="card__arrow"><%- icon('arrow', 15) %></span></span>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Materials we work in</p>
      <div class="tablewrap" style="margin-top:1.5rem;">
        <table class="dtable">
          <thead>
            <tr><th scope="col">Material</th><th scope="col">Main property</th><th scope="col">Usually specified for</th></tr>
          </thead>
          <tbody>
            <% materials.forEach(function(m){ %>
              <tr>
                <td><%= m.name %></td>
                <td style="color:var(--ink-2);"><%= m.main_property %></td>
                <td style="color:var(--ink-3);"><%= m.specified_for %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p style="margin-top:1.5rem;"><a class="tlink" href="/materials">Full material reference <%- icon('arrow', 15) %></a></p>
    </div>
  </section>

  <%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
