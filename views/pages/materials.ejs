<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <section class="phero gridbg">
    <div class="wrap">
      <p class="eyebrow">Reference</p>
      <h1 class="h-page phero__title" style="max-width:20ch;"><%- h.dot('The material decides the performance.') %></h1>
      <p class="lede">
        This table is a starting point for specification. The correct construction for any given product
        should always be confirmed against your product data, temperature range and handling method &mdash;
        which is what we do before quoting anything.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="tablewrap">
        <table class="dtable">
          <thead>
            <tr>
              <th scope="col">Material</th>
              <th scope="col">Main property</th>
              <th scope="col">Usually specified for</th>
            </tr>
          </thead>
          <tbody>
            <% materials.forEach(function(m){ %>
              <tr>
                <td><%= m.name %></td>
                <td style="color:var(--ink-2);"><%= m.main_property %></td>
                <td style="color:var(--ink-3);"><%= m.specified_for %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="cards cards--2" style="margin-top:3rem;">
        <% materials.forEach(function(m){ %>
          <% if (m.detail) { %>
            <div class="card">
              <span class="card__num"><%= m.main_property %></span>
              <h2 class="card__title" style="font-size:1.08rem;"><%= m.name %></h2>
              <p class="card__desc"><%= m.detail %></p>
            </div>
          <% } %>
        <% }) %>
      </div>

      <div class="notice notice--warn" style="margin-top:2.5rem;max-width:70ch;">
        <strong>Send the product data sheet first.</strong> Material compatibility is worked out case by
        case before anything is quoted. Where a material is not the right answer for your product, we say so.
      </div>
    </div>
  </section>

  <%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
