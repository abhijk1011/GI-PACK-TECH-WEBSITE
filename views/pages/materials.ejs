<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <section class="phero gridbg">
    <div class="wrap phero__grid">
      <div class="phero__main">
        <p class="eyebrow">Reference</p>
        <h1 class="h-page">Material guide</h1>
      </div>
      <div class="phero__side">
        <p class="lede">
          The material decides the performance. This is a starting point, not an answer: the right
          construction is confirmed against your product data, temperature range and handling
          method before anything is quoted.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight section--rule">
    <div class="wrap">
      <div class="tablewrap">
        <table class="dtable">
          <thead>
            <tr>
              <th scope="col">Material</th>
              <th scope="col">Main property</th>
              <th scope="col">Usually specified for</th>
            </tr>
          </thead>
          <tbody>
            <% materials.forEach(function(m){ %>
              <tr>
                <td><%= m.name %></td>
                <td style="color:var(--ink-2);"><%= m.main_property %></td>
                <td style="color:var(--ink-3);"><%= m.specified_for %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div style="margin-top:clamp(3rem, 5vw, 4.5rem);">
        <%- include('../partials/shead', { sh: { eyebrow: 'In detail', title: 'How each material behaves' } }) %>
      </div>
      <div class="cards cards--2">
        <% materials.forEach(function(m){ %>
          <% if (m.detail) { %>
            <div class="card">
              <span class="card__num"><%= m.main_property %></span>
              <h2 class="card__title" style="font-size:1.08rem;"><%= m.name %></h2>
              <p class="card__desc"><%= m.detail %></p>
            </div>
          <% } %>
        <% }) %>
      </div>

      <div class="notice notice--warn" style="margin-top:2.5rem;">
        <strong>Send the product data sheet first.</strong> Where a material is not the right answer
        for your product, we say so.
      </div>
    </div>
  </section>

  <%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
</body>
</html>
