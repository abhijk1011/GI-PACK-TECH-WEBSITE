<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <section class="phero gridbg">
    <div class="wrap">
      <p class="eyebrow"><%= b.hero_eyebrow %></p>
      <h1 class="h-page phero__title" style="max-width:20ch;"><%- h.dot(b.hero_heading) %></h1>
      <p class="lede"><%= b.intro %></p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="measure--form">
      <% if (sent) { %>
        <div class="notice" style="margin-bottom:2.5rem;">
          <strong>Received.</strong> <%= s.enquiry_thanks %>
        </div>
      <% } %>

      <div class="steps">
        <div class="step" data-active="true">
          <div class="step__n">Step 01</div>
          <div class="step__t">Your requirement</div>
        </div>
        <div class="step">
          <div class="step__n">Step 02</div>
          <div class="step__t">Conditions</div>
        </div>
        <div class="step">
          <div class="step__n">Step 03</div>
          <div class="step__t">Volume &amp; contact</div>
        </div>
      </div>

      <form method="post" action="/enquiry" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="source" value="specify">
        <!-- honeypot -->
        <div class="visually-hidden" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
        </div>

        <% [1,2,3].forEach(function(step){ %>
          <% var items = checklist.filter(function(c){ return c.step === step; }); %>
          <% if (items.length) { %>
            <fieldset class="fset">
              <legend class="fset__legend">
                <span class="fset__step">Step 0<%= step %></span>
                <span class="fset__title">
                  <%- h.dot(step === 1 ? 'What are you packing?' : (step === 2 ? 'How is it handled?' : 'Volume and how to reach you')) %>
                </span>
              </legend>

              <% if (step === 1) { %>
                <div class="field">
                  <label class="field__label" for="product">Product you are enquiring about</label>
                  <select id="product" name="product">
                    <option value="">Not sure yet — advise me</option>
                    <% products.forEach(function(p){ %>
                      <option value="<%= p.name %>" <%= prefill === p.name ? 'selected' : '' %>><%= p.name %></option>
                    <% }) %>
                  </select>
                  <span class="field__why">Tells us which line the specification starts from</span>
                </div>
              <% } %>

              <div class="formgrid">
                <% items.forEach(function(c){ %>
                  <div class="field <%= c.required ? 'field--req' : '' %>">
                    <label class="field__label" for="f_<%= c.field_key %>"><%= c.question %></label>
                    <% if (c.input_type === 'select') { %>
                      <select id="f_<%= c.field_key %>" name="<%= c.field_key %>" <%= c.required ? 'required' : '' %>>
                        <option value="">Select…</option>
                        <% h.lines(c.options).forEach(function(opt){ %>
                          <option value="<%= opt %>"><%= opt %></option>
                        <% }) %>
                      </select>
                    <% } else if (c.input_type === 'textarea') { %>
                      <textarea id="f_<%= c.field_key %>" name="<%= c.field_key %>" <%= c.required ? 'required' : '' %>></textarea>
                    <% } else { %>
                      <input type="text" id="f_<%= c.field_key %>" name="<%= c.field_key %>" <%= c.required ? 'required' : '' %>>
                    <% } %>
                    <% if (c.why) { %><span class="field__why"><%= c.why %></span><% } %>
                  </div>
                <% }) %>
              </div>
            </fieldset>
          <% } %>
        <% }) %>

        <fieldset class="fset">
          <legend class="fset__legend">
            <span class="fset__step">Your details</span>
          </legend>
          <div class="formgrid">
            <div class="field field--req">
              <label class="field__label" for="name">Name</label>
              <input type="text" id="name" name="name" required autocomplete="name">
            </div>
            <div class="field field--req">
              <label class="field__label" for="company">Company</label>
              <input type="text" id="company" name="company" required autocomplete="organization">
            </div>
            <div class="field field--req">
              <label class="field__label" for="email">Email</label>
              <input type="email" id="email" name="email" required autocomplete="email">
            </div>
            <div class="field">
              <label class="field__label" for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel">
            </div>
            <div class="field">
              <label class="field__label" for="job_role">Your role</label>
              <select id="job_role" name="job_role">
                <option value="">Select…</option>
                <% roles.forEach(function(r){ %>
                  <option value="<%= r.name %>"><%= r.name %></option>
                <% }) %>
                <option value="Other">Other</option>
              </select>
              <span class="field__why">Lets us answer in the terms you are measured on</span>
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="message">Anything else we should know</label>
            <textarea id="message" name="message" placeholder="Current problem, failure you are seeing, drawings you can send…"></textarea>
          </div>
        </fieldset>

        <div class="btn-row">
          <button class="btn btn--primary" type="submit">
            Send requirement <span class="btn__arrow"><%- icon('arrow', 16) %></span>
          </button>
          <a class="btn btn--ghost" href="tel:<%= (s.phone||'').replace(/\s/g,'') %>">Or call <%= s.phone %></a>
        </div>
        <p class="field__why" style="margin-top:1.35rem;">
          Answer what you know. The rest can follow.
        </p>
      </form>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
</body>
</html>
