<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">

  <!-- ============================================ hero: the one idea -->
  <section class="hero gridbg">
    <div class="wrap hero__grid">
      <div class="hero__col">
        <p class="eyebrow"><%= b.hero_eyebrow %></p>
        <%#
          The headline is set in two registers rather than one block. Every line
          but the last is the lead-in — around half the size, lighter, grey. The
          last line is the payoff, at full size and weight, and it takes the
          brand-coloured full stop. The size contrast is what gives the section
          its impact, and it holds at the same ratio down to a phone.

          A line break in the admin field is what separates them, so the split
          stays editable. A single-line heading is all payoff.
        %>
        <h1 class="h-hero hero__title">
          <% var heroLines = (b.hero_heading || '').split('\n').filter(function(l){ return l.trim(); }); %>
          <% heroLines.forEach(function(line, i){ %>
            <% var isPayoff = i === heroLines.length - 1; %>
            <span class="<%= isPayoff ? 'hero__payoff' : 'hero__lead' %>"><%- isPayoff ? h.dot(line) : h.escapeHtml(line) %></span>
          <% }) %>
        </h1>
        <p class="hero__sub"><%= b.hero_sub %></p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/specify">
            <%= s.cta_primary %> <span class="btn__arrow"><%- icon('arrow', 16) %></span>
          </a>
          <a class="btn btn--ghost" href="/products">See the range</a>
        </div>

        <dl class="hero__stats">
          <div class="stat">
            <dd class="stat__value"><%= s.stat_products %></dd>
            <dt class="stat__label">Products</dt>
          </div>
          <div class="stat">
            <dd class="stat__value"><%= s.stat_diameter %></dd>
            <dt class="stat__label">Drum diameter</dt>
          </div>
          <div class="stat">
            <dd class="stat__value"><%= new Date().getFullYear() - Number(s.established_year || 2006) %> yrs</dd>
            <dt class="stat__label">Manufacturing</dt>
          </div>
        </dl>
      </div>

      <%#
        The hero artwork, set from the image panel at /admin.
        It is deliberately unframed — no border, no shadow —
        because the artwork this is built for is a composite illustration on a
        transparent ground, and a frame around it would read as a mistake.
        A photograph still looks right here: the rounding is harmless on a
        transparent PNG and tidies a square-cropped photo.
      %>
      <figure class="hero__figure">
        <% if (b.hero_image) { %>
          <img class="hero__art" src="<%= b.hero_image %>" alt="<%= b.hero_image_alt %>"
               fetchpriority="high" decoding="async">
        <% } else { %>
          <div class="hero__artslot">
            <div>
              <%- icon('image', 30) %>
              <span class="slot__label">Hero artwork</span>
            </div>
          </div>
        <% } %>
      </figure>
    </div>
  </section>

  <!-- ============================================ the value equation -->
  <section class="section section--paper section--rule" id="value">
    <div class="wrap">
      <div class="shead">
        <div class="shead__text">
          <p class="eyebrow"><%= b.value_eyebrow %></p>
          <h2 class="h-section" data-reveal><%- h.dot(b.value_heading) %></h2>
          <p class="lede"><%= b.value_sub %></p>
        </div>
      </div>

      <div class="value" data-reveal>
        <div class="value__head">
          <div class="value__headcell">What the buyer sees</div>
          <div class="value__headcell">What the buyer does not see</div>
        </div>
        <% valueRows.forEach(function(row){ %>
          <div class="value__row">
            <div class="value__cell value__cell--seen"><%= row.seen %></div>
            <div class="value__cell value__cell--unseen"><%= row.unseen %></div>
          </div>
        <% }) %>
      </div>

      <div class="value__qs" data-reveal>
        <div class="value__q">
          <div class="value__qnum">Question 01</div>
          <p class="value__qtext"><%- h.dot(b.value_q1) %></p>
        </div>
        <div class="value__q">
          <div class="value__qnum">Question 02</div>
          <p class="value__qtext"><%- h.dot(b.value_q2) %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ product range -->
  <section class="section" id="range">
    <div class="wrap">
      <div class="shead">
        <div class="shead__text">
          <p class="eyebrow"><%= b.range_eyebrow %></p>
          <h2 class="h-section"><%- h.dot(b.range_heading) %></h2>
          <p class="lede"><%= b.range_sub %></p>
        </div>
        <a class="tlink" href="/products">All <%= s.stat_products %> products <%- icon('arrow', 15) %></a>
      </div>

      <div class="cards cards--3">
        <% categories.forEach(function(c){ %>
          <a class="card" href="/products/<%= c.slug %>">
            <span class="card__num"><%= c.number %> / <%= s.stat_categories %></span>
            <h3 class="card__title"><%= c.name %></h3>
            <p class="card__desc"><%= c.tagline %></p>
            <span class="card__meta">
              <span><%= c.count %> product<%= c.count === 1 ? '' : 's' %></span>
              <span class="card__arrow"><%- icon('arrow', 16) %></span>
            </span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============================================ the 6"–100" capability -->
  <section class="section section--paper section--rule" id="diameter">
    <div class="wrap">
      <div class="shead">
        <div class="shead__text">
          <p class="eyebrow"><%= b.diameter_eyebrow %></p>
          <h2 class="h-section"><%- h.dot(b.diameter_heading) %></h2>
          <p class="lede"><%= b.diameter_sub %></p>
        </div>
      </div>

      <div class="scale" data-reveal>
        <div class="scale__track">
          <% [
            { d: 6,   label: '6"',   note: 'Lab containers' },
            { d: 14,  label: '14"',  note: 'Small drums' },
            { d: 23,  label: '23"',  note: '200 L drums' },
            { d: 40,  label: '40"',  note: 'Bulk drums' },
            { d: 65,  label: '65"',  note: 'Open-top' },
            { d: 100, label: '100"', note: 'Bulk containers' }
          ].forEach(function(item){ %>
            <div class="scale__item" title="<%= item.note %>">
              <div class="scale__circle" style="--d: <%= 22 + item.d * 1.35 %>px;"></div>
              <span class="scale__label"><%= item.label %></span>
            </div>
          <% }) %>
        </div>
        <div class="scale__rule">
          <span>Min &empty; 6 in</span>
          <span>Internal diameter — any height</span>
          <span>Max &empty; 100 in</span>
        </div>
      </div>

      <div class="btn-row" style="margin-top:2rem;">
        <a class="btn btn--ink" href="/products/round-drum-liners">
          Round drum liners <span class="btn__arrow"><%- icon('arrow', 16) %></span>
        </a>
        <a class="btn btn--ghost" href="/materials">Material reference</a>
      </div>
    </div>
  </section>

  <!-- ============================================ start where the problem is -->
  <section class="section" id="roles">
    <div class="wrap">
      <div class="shead">
        <div class="shead__text">
          <p class="eyebrow"><%= b.roles_eyebrow %></p>
          <h2 class="h-section"><%- h.dot(b.roles_heading) %></h2>
        </div>
      </div>

      <div class="roles">
        <% roles.forEach(function(r){ %>
          <a class="role" href="/for/<%= r.slug %>">
            <span class="role__icon"><%- icon(r.icon || 'users', 30) %></span>
            <h3 class="role__name"><%= r.name %></h3>
            <p class="role__cares"><%= r.cares_about %></p>
            <span class="role__go">See what matters here <%- icon('arrow', 14) %></span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============================================ featured / upsell -->
  <section class="section section--paper section--rule">
    <div class="wrap">
      <div class="shead">
        <div class="shead__text">
          <p class="eyebrow">Where the argument is easiest to see</p>
          <h2 class="h-section"><%- h.dot('The products that change how a plant works.') %></h2>
        </div>
        <a class="tlink" href="/products">Full range <%- icon('arrow', 15) %></a>
      </div>

      <div class="cards cards--3 cards--loose">
        <% featured.forEach(function(p){ %>
          <%- include('../partials/product-card', { p: p }) %>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============================================ proof -->
  <% if (proof.length) { %>
  <section class="section">
    <div class="wrap">
      <div class="shead">
        <div class="shead__text">
          <p class="eyebrow"><%= b.proof_eyebrow %></p>
          <h2 class="h-section"><%- h.dot(b.proof_heading) %></h2>
        </div>
      </div>
      <div class="gallerystrip">
        <% proof.slice(0, 8).forEach(function(img){ %>
          <figure>
            <a href="/products/<%= img.category_slug %>/<%= img.slug %>">
              <img src="<%= img.path %>" alt="<%= img.alt || img.name %>" loading="lazy" width="500" height="375">
            </a>
            <figcaption><%= img.caption || img.name %></figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ============================================ industries -->
  <section class="section section--paper section--rule">
    <div class="wrap">
      <div class="shead">
        <div class="shead__text">
          <p class="eyebrow">Industries</p>
          <h2 class="h-section"><%- h.dot('Different sectors, the same question: what is this protecting?') %></h2>
        </div>
        <a class="tlink" href="/industries">All industries <%- icon('arrow', 15) %></a>
      </div>

      <div class="cards cards--4">
        <% industries.forEach(function(i){ %>
          <a class="card" href="/industries/<%= i.slug %>">
            <h3 class="card__title" style="font-size:1.05rem;"><%= i.name %></h3>
            <p class="card__desc" style="font-size:.88rem;"><%= i.applications %></p>
            <span class="card__meta">
              <span></span>
              <span class="card__arrow"><%- icon('arrow', 15) %></span>
            </span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ============================================ the plant -->
  <section class="section">
    <div class="wrap">
      <div class="split split--top">
        <div>
          <p class="eyebrow"><%= b.plant_eyebrow %></p>
          <h2 class="h-section" style="margin-bottom:1.5rem;"><%- h.dot(b.plant_heading) %></h2>
          <div class="prose"><p><%= b.plant_body %></p></div>
          <div class="btn-row" style="margin-top:2rem;">
            <a class="btn btn--ghost" href="/faq">Common questions</a>
            <a class="btn btn--ghost" href="/about">About the company</a>
          </div>
        </div>
        <div>
          <ul class="cards cards--2" style="grid-template-columns:repeat(2, 1fr);">
            <li class="card"><span class="card__num">01</span><h3 class="card__title" style="font-size:1.02rem;">Lamination</h3><p class="card__desc" style="font-size:.86rem;">Multilayer and foil laminate structures</p></li>
            <li class="card"><span class="card__num">02</span><h3 class="card__title" style="font-size:1.02rem;">Extrusion</h3><p class="card__desc" style="font-size:.86rem;">Co-extruded film, more strength from less material</p></li>
            <li class="card"><span class="card__num">03</span><h3 class="card__title" style="font-size:1.02rem;">Cutting</h3><p class="card__desc" style="font-size:.86rem;">Any diameter, any profile, one-off or bulk</p></li>
            <li class="card"><span class="card__num">04</span><h3 class="card__title" style="font-size:1.02rem;">Heat sealing</h3><p class="card__desc" style="font-size:.86rem;">Where barrier films are made or lost</p></li>
            <li class="card"><span class="card__num">05</span><h3 class="card__title" style="font-size:1.02rem;">In-house R&amp;D</h3><p class="card__desc" style="font-size:.86rem;">Material specified against your product data</p></li>
            <li class="card"><span class="card__num">06</span><h3 class="card__title" style="font-size:1.02rem;">Quality</h3><p class="card__desc" style="font-size:.86rem;"><%= s.show_iso === '1' ? s.iso_text : 'Tested before dispatch' %></p></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/cta', {
    ctaEyebrow: b.cta_eyebrow,
    ctaHeading: b.cta_heading,
    ctaBody: b.cta_body
  }) %>

</main>

<%- include('../partials/footer') %>
</body>
</html>
