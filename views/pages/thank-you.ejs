<!doctype html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<main id="main">
  <section class="section gridbg">
    <div class="wrap phero--center" style="padding-block:3rem;">
      <p class="eyebrow eyebrow--plain">Enquiry received</p>
      <h1 class="h-page" style="margin-bottom:1.35rem;">Thank you for your enquiry</h1>
      <p class="lede measure--tight" style="margin-inline:auto;"><%= s.enquiry_thanks %></p>
      <p class="measure--tight muted" style="margin-inline:auto;margin-top:1.35rem;">
        Need an answer sooner? Call
        <a class="tlink tlink--brand" href="tel:<%= (s.phone||'').replace(/\s/g,'') %>"><%= s.phone %></a>.
      </p>
      <div class="btn-row" style="justify-content:center;margin-top:2rem;">
        <a class="btn btn--primary" href="/products">See all products</a>
        <a class="btn btn--ghost" href="/">Back to home</a>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<%# Both enquiry forms land here only after Netlify accepts a submission, so
    reaching this page is the conversion: it is what Ads Manager counts as a
    Lead. Nothing from the form is sent with it. Guarded so the page is
    unaffected if the pixel is ever taken out of head_scripts. %>
<script>if (window.fbq) fbq('track', 'Lead');</script>
</body>
</html>
