# Copy to .env and edit before running in production.

# Port the app listens on.
PORT=3000

# Set to "production" on a live server. This makes session cookies
# secure-only, so the site must be served over HTTPS.
NODE_ENV=production

# Long random string. Signs the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Where the SQLite database lives. Point this at a persistent disk in
# production, otherwise the content is lost on every redeploy.
DATA_DIR=./data

# Where admin-uploaded images are written. Also needs to be persistent.
UPLOAD_DIR=./public/uploads

# Only read the first time you run `npm run seed`, to create the admin login.
ADMIN_EMAIL=admin@gipacktech.com
ADMIN_PASSWORD=change-this-before-you-seed
