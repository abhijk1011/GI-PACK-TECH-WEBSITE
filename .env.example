# Local development only. On Netlify these are set under
# Project configuration -> Environment variables.

# --- Required ---------------------------------------------------------------

# Postgres connection string.
# On Netlify this is provided automatically as NETLIFY_DATABASE_URL once you
# enable Netlify DB, so you do not need to set it there.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string. Signs the admin session cookie.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# --- Recommended in production ----------------------------------------------

# Makes session cookies HTTPS-only. Netlify always serves HTTPS.
NODE_ENV=production

# --- Only read the first time the database is seeded ------------------------

ADMIN_EMAIL=admin@gipacktech.com
ADMIN_PASSWORD=choose-a-strong-password-before-first-deploy

# --- Local development without a database -----------------------------------

# Runs an in-process Postgres so you can work offline. Never set this on Netlify.
# USE_PGLITE=1

# Port for `npm start`.
PORT=3000
